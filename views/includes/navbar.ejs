<style>
 
.btn-search {
    background: linear-gradient(135deg, #fe424d, #ff6b75);
    color: white;
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(254, 66, 77, 0.3);
    position: relative;
    overflow: hidden;
    cursor: pointer;
}


.btn-search::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.btn-search:hover {
    background: linear-gradient(135deg, #ff6b75, #fe424d);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(254, 66, 77, 0.4);
}

.btn-search:hover::before {
    width: 200px;
    height: 200px;
}

.btn-search:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(254, 66, 77, 0.3);
}

.btn-search i {
    margin: 0;
    transition: transform 0.3s ease;
}

.btn-search:hover i {
    transform: scale(1.1) rotate(5deg);
}


.search-inp {
    border-radius: 25px;
    padding: 0.5rem 3rem;
    border: 2px solid #e0e0e0;
    transition: all 0.3s ease;
    background: #ffffff !important;
    color: #333333;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    font-size: 15px;
    position: relative;
}

.search-inp:hover {
    border-color: #fe424d;
    box-shadow: 0 4px 12px rgba(254, 66, 77, 0.15);
}

.search-inp:focus {
    outline: none;
    border-color: #fe424d;
    box-shadow: 0 4px 16px rgba(254, 66, 77, 0.25);
    transform: translateY(-2px);
    background: #fff;
}


.search-inp::placeholder {
    color: #999;
    transition: color 0.3s ease;
}

.search-inp:focus::placeholder {
    color: #ccc;
}

.navbar-brand {
    color: #fe424d !important;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    display: inline-block;
    position: relative;
    text-shadow: 0 2px 4px rgba(254, 66, 77, 0.1);
}


.navbar-brand::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, #fe424d, #ff6b75);
    transition: width 0.3s ease;
    border-radius: 2px;
}

.navbar-brand:hover {
    transform: scale(1.05);
    color: #ff6b75 !important;
    text-shadow: 0 4px 8px rgba(254, 66, 77, 0.2);
}

.navbar-brand:hover::after {
    width: 100%;
}

.navbar-brand:active {
    transform: scale(0.98);
}


.search-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
}


.search-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
}


.input-group .search-inp {
    border-right: none;
}

.input-group .btn-search {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}


.btn-search:hover i {
    animation: searchPulse 0.6s ease-in-out;
}


.btn-search.loading {
    pointer-events: none;
    opacity: 0.7;
}

.btn-search.loading i {
    animation: spin 1s linear infinite;
}


.btn-search:focus-visible,
.search-inp:focus-visible {
    outline: 2px solid #fe424d;
    outline-offset: 2px;
}


@media (max-width: 768px) {
    .search-inp {
        padding: 0.5rem 2rem;
        font-size: 14px;
    }

    .navbar-brand {
        font-size: 20px;
    }

    .btn-search {
        padding: 0 1rem;
    }
}

@media (max-width: 480px) {
    .search-inp {
        padding: 0.5rem 1.5rem;
        font-size: 13px;
    }

    .navbar-brand {
        font-size: 18px;
    }

    .btn-search {
        padding: 0 1rem;
        gap: 0.25rem;
    }
}


@media (prefers-color-scheme: dark) {
    .search-inp {
        background: #2d3436;
        border-color: #4a4a4a;
        color: #dcdde1;
    }

    .search-inp:hover {
        border-color: #fe424d;
    }

    .search-inp::placeholder {
        color: #636e72;
    }
}


* {
    -webkit-tap-highlight-color: transparent;
}

::selection {
    background: #fe424d;
    color: white;
}
</style>

<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="#"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>

      </div>

      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search" method="GET" action="/listings">
          <input class="form-control me-2 search-inp" type="search" name="location" placeholder="Search Destinations" aria-label="Search" />
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search</button>
        </form>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if(!currUser){ %>
          <a class="nav-link active" aria-current="page" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
          <% } %>

            <% if(currUser) { %>
              <a class="nav-link" href="/logout"><b>Log out</b></a>
              <% } %>


      </div>
    </div>
  </div>
</nav>