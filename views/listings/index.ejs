<% layout("layouts/boilerplate") -%>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-slides">
    <div class="hero-slide active" style="background-image: url('https://images.unsplash.com/photo-1468413253725-0d5181091126?w=1920&auto=format&fit=crop&q=80')"></div>
    <div class="hero-slide" style="background-image: url('https://plus.unsplash.com/premium_photo-1673240367277-e1d394465b56?w=1920&auto=format&fit=crop&q=80')"></div>
    <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1573865174887-dd85bc60e3e5?w=1920&auto=format&fit=crop&q=80')"></div>
    <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1688653802629-5360086bf632?w=1920&auto=format&fit=crop&q=80')"></div>
    <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1554995207-c18c203602cb?w=1920&auto=format&fit=crop&q=80')"></div>
  </div>
  <div class="hero-overlay"></div>
  <h1>Find Your Perfect Stay</h1>
  <p>Discover unique homes, experiences, and places around the world — from cozy cabins to beachfront villas.</p>
  <a href="#listings" class="btn-hero">
    <i class="fa-solid fa-magnifying-glass"></i> Start Exploring
  </a>
</section>

<!-- Filters Bar -->
<div class="filters-wrapper">
  <button class="scroll-btn" id="scrollLeft" aria-label="Scroll filters left">&#8249;</button>

  <div id="filters">
    <div class="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-city"></i></div>
      <p>Iconic Cities</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-umbrella-beach"></i></div>
      <p>Beach</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountain</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-house"></i></div>
      <p>Cabins</p>
    </div>
    <div class="filter">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-tractor"></i></div>
      <p>Farms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Pools</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-person-hiking"></i></div>
      <p>Camp</p>
    </div>
    <div class="filter">
      <div><i class="fa-regular fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
  </div>

  <button class="scroll-btn" id="scrollRight" aria-label="Scroll filters right">&#8250;</button>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Show with taxes</label>
    </div>
  </div>
</div>

<!-- Listing Cards Grid -->
<div id="listings" class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="<%= listing.title %>"
          loading="lazy"
        >
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br>
            &#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : 'N/A' %> / night
            <i class="gst-text">+18% GST</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  // Hero Image Slideshow
  const heroSlides = document.querySelectorAll('.hero-slide');
  let currentSlide = 0;

  setInterval(() => {
    heroSlides[currentSlide].classList.remove('active');
    currentSlide = (currentSlide + 1) % heroSlides.length;
    heroSlides[currentSlide].classList.add('active');
  }, 5000);

  // Tax toggle
  const taxSwitch = document.getElementById('switchCheckDefault');
  taxSwitch.addEventListener('click', () => {
    const taxInfo = document.getElementsByClassName('gst-text');
    for (const info of taxInfo) {
      info.style.display = taxSwitch.checked ? 'inline' : 'none';
    }
  });

  // Filter scroll
  const filterContainer = document.getElementById('filters');
  const scrollLeftBtn = document.getElementById('scrollLeft');
  const scrollRightBtn = document.getElementById('scrollRight');

  scrollLeftBtn.addEventListener('click', () => {
    filterContainer.scrollBy({ left: -200, behavior: 'smooth' });
  });

  scrollRightBtn.addEventListener('click', () => {
    filterContainer.scrollBy({ left: 200, behavior: 'smooth' });
  });

  function updateScrollButtons() {
    scrollLeftBtn.disabled = filterContainer.scrollLeft === 0;
    scrollRightBtn.disabled =
      filterContainer.scrollLeft + filterContainer.clientWidth >= filterContainer.scrollWidth - 10;
  }

  filterContainer.addEventListener('scroll', updateScrollButtons);
  updateScrollButtons();

  // Navbar scroll effect
  window.addEventListener('scroll', () => {
    document.querySelector('.navbar').classList.toggle('scrolled', window.scrollY > 20);
  });
</script>
