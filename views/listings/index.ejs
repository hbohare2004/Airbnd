<% layout("layouts/boilerplate") -%>

    <body>
        <style>
            /* Filters Container */
#filters {
    display: flex;
    flex-wrap: nowrap;
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 10px;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
    position: relative;
}

#filters::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 10px;
    width: 30px;
    background: linear-gradient(to right, rgba(248, 249, 250, 1), transparent);
    pointer-events: none;
    z-index: 1;
}

#filters::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    bottom: 10px;
    width: 30px;
    background: linear-gradient(to left, rgba(248, 249, 250, 1), transparent);
    pointer-events: none;
    z-index: 1;
}

#filters::-webkit-scrollbar {
    display: none;
}

/* Individual Filter Item */
.filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 10px;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
    min-width: 80px;
    border-radius: 12px;
    position: relative;
    background: transparent;
}

.filter::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, #0984e3, #6c5ce7);
    transition: width 0.3s ease;
    border-radius: 2px;
}

.filter:hover {
    background-color: #f0f0f0;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
}

.filter:hover::before {
    width: 60%;
}

.filter:active {
    transform: translateY(0);
}

/* Active Filter State */
.filter.active {
    background-color: #e8f4f8;
    box-shadow: 0 4px 12px rgba(9, 132, 227, 0.2);
}

.filter.active::before {
    width: 60%;
}

/* Tax Toggle */
.tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.5rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    background: #ffffff;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    position: relative;
    overflow: hidden;
}

.tax-toggle::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(108, 92, 231, 0.1), transparent);
    transition: left 0.6s ease;
}

.tax-toggle:hover {
    border-color: #6c5ce7;
    box-shadow: 0 4px 12px rgba(108, 92, 231, 0.2);
    transform: translateY(-2px);
}

.tax-toggle:hover::before {
    left: 100%;
}

/* GST Text */
.gst-text {
    margin-left: 15px;
    font-size: 0.9em;
    color: #666;
    display: none;
    font-weight: 500;
    transition: color 0.3s ease;
}

.tax-toggle:hover .gst-text {
    color: #6c5ce7;
}

/* Filters Wrapper */
.filters-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    padding: 15px 0;
    position: relative;
}

.filters-wrapper::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, #e0e0e0, transparent);
}

#filters {
    flex: 1;
}

.tax-toggle {
    flex-shrink: 0;
}

/* Scroll Buttons Container */
.scroll-buttons {
    display: flex;
    gap: 5px;
    align-items: center;
    flex-shrink: 0;
}

/* Scroll Buttons */
.scroll-btn {
    background: linear-gradient(135deg, #333, #444);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
}

.scroll-btn::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.4s, height 0.4s;
}

.scroll-btn:hover {
    background: linear-gradient(135deg, #555, #666);
    transform: scale(1.1);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
}

.scroll-btn:hover::before {
    width: 100px;
    height: 100px;
}

.scroll-btn:active {
    transform: scale(0.95);
}

.scroll-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
}

.scroll-btn:disabled:hover {
    background: #ccc;
    transform: none;
}

.scroll-btn:disabled::before {
    display: none;
}

/* Filter Icon/Image Styling */
.filter img,
.filter i {
    transition: transform 0.3s ease;
    filter: grayscale(20%);
}

.filter:hover img,
.filter:hover i {
    transform: scale(1.1);
    filter: grayscale(0%);
}

.filter.active img,
.filter.active i {
    filter: grayscale(0%);
}

/* Filter Text */
.filter span {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #2d3436;
    transition: color 0.3s ease;
}

.filter:hover span {
    color: #0984e3;
}

.filter.active span {
    color: #0984e3;
    font-weight: 600;
}

/* Responsive Adjustments */
.filter {
    min-width: 90px;
}

@media (max-width: 768px) {
    .filters-wrapper {
        gap: 15px;
    }

    .scroll-btn {
        width: 36px;
        height: 36px;
        font-size: 16px;
    }
}

@media (max-width: 480px) {
    .filter {
        min-width: 100px;
        padding: 8px;
    }

    .filters-wrapper {
        gap: 10px;
    }

    .tax-toggle {
        height: 3rem;
        padding: 0.75rem;
        font-size: 0.9em;
    }

    .scroll-btn {
        width: 32px;
        height: 32px;
        font-size: 14px;
    }

    #filters {
        gap: 15px;
    }
}

/* Smooth Loading Animation */
@keyframes fadeInSlide {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.filter {
    animation: fadeInSlide 0.4s ease forwards;
}

.filter:nth-child(1) { animation-delay: 0.05s; }
.filter:nth-child(2) { animation-delay: 0.1s; }
.filter:nth-child(3) { animation-delay: 0.15s; }
.filter:nth-child(4) { animation-delay: 0.2s; }
.filter:nth-child(5) { animation-delay: 0.25s; }

/* Focus Styles for Accessibility */
.filter:focus,
.scroll-btn:focus,
.tax-toggle:focus {
    outline: 2px solid #6c5ce7;
    outline-offset: 2px;
}

/* Selection Style */
::selection {
    background: #ffeaa7;
    color: #2d3436;
}
        </style>


        <div class="filters-wrapper">
            <button class="scroll-btn" id="scrollLeft">‹</button>
            
            <div id="filters">
                <div class="filter">
                    <div><i class="fa-solid fa-fire"></i></div>
                    <p>Trending</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-bed"></i></div>
                    <p>Bed</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-city"></i></div>
                    <p>Iconic Cities</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-umbrella-beach"></i></div>
                    <p>Beach</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-mountain"></i></div>
                    <p>Mountain</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-house"></i></div>
                    <p>Cabins</p>
                </div>

                <div class="filter">
                    <div><i class="fa-brands fa-fort-awesome"></i></div>
                    <p>Castles</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-tractor"></i></div>
                    <p>Farms</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p>Pools</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-person-hiking"></i></div>
                    <p>Camp</p>
                </div>

                <div class="filter">
                    <div><i class="fa-regular fa-snowflake"></i></div>
                    <p>Arctic</p>
                </div>
            </div>

            <button class="scroll-btn" id="scrollRight">›</button>

            <div class="tax-toggle">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Default total after taxes</label>
                </div>
            </div>
        </div>

        <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 g-4 ">
            <% for(let listing of allListings){ %>
                <a href="/listings/<%=listing._id%>" class="listing-link">
                    <div class="card col">
                        <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image">
                        <div class="card-img-overlay">
                            <h5 class="card-title"></h5>
                            <p class="card-text"></p>
                            <p class="card-text"></p>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= listing.title %>
                                </b> <br>
                                ₹ <%= listing.price !=null ? listing.price.toLocaleString("en-IN") : 'N/A' %> / night
                                <i class="gst-text">+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>


        <!-- <ul> 
    <% for(let listing of allListings){ %>
        <li><a href="/listings/<%= listing._id %>"> <%= listing.title %> </a></li>
    <% } %>
    </ul> -->



    </body>

    <script>
        // Tax toggle functionality
        let taxSwitch = document.getElementById('switchCheckDefault');
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName('gst-text');
            for(info of taxInfo) {
                info.style.display = taxSwitch.checked ? 'inline' : 'none';
            }
        })

        // Scroll functionality
        const filterContainer = document.getElementById('filters');
        const scrollLeftBtn = document.getElementById('scrollLeft');
        const scrollRightBtn = document.getElementById('scrollRight');
        const scrollAmount = 200;

        scrollLeftBtn.addEventListener('click', () => {
            filterContainer.scrollBy({
                left: -scrollAmount,
                behavior: 'smooth'
            });
        });

        scrollRightBtn.addEventListener('click', () => {
            filterContainer.scrollBy({
                left: scrollAmount,
                behavior: 'smooth'
            });
        });

        // Update button disabled state
        function updateScrollButtons() {
            const isAtStart = filterContainer.scrollLeft === 0;
            const isAtEnd = filterContainer.scrollLeft + filterContainer.clientWidth >= filterContainer.scrollWidth - 10;
            
            scrollLeftBtn.disabled = isAtStart;
            scrollRightBtn.disabled = isAtEnd;
        }

        filterContainer.addEventListener('scroll', updateScrollButtons);
        updateScrollButtons();
    </script>